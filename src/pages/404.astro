---
import ContactBlock from '../components/ContactBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/paths';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="section not-found" aria-labelledby="nf-title">
    <div class="container">
      <p class="eyebrow"><span class="num">404</span> Page not found</p>
      <h1 id="nf-title">This page isn’t here.</h1>
      <p class="lede">The link may be old, or the address may have a typo.</p>
      <div class="nf-actions">
        <a class="btn btn-primary" href={href('/')}>Go to the home page</a>
        <a class="btn btn-ghost" href={href('/work/')}>See all work</a>
      </div>
    </div>
  </section>
  <ContactBlock compact />
</BaseLayout>

<style>
  .not-found .container {
    display: grid;
    gap: 1.5rem;
    min-height: 55vh;
    align-content: center;
  }

  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
