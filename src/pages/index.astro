---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import ContactBlock from '../components/ContactBlock.astro';
import DotField from '../components/DotField.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import HeroStage from '../components/HeroStage.astro';
import LogoStrip from '../components/LogoStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import { chapters } from '../data/chapters';
import { certifications, education, experience, research } from '../data/experience';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/paths';
import { getFeatured, getWork, type Work } from '../lib/work';

const all = await getWork();
const featured = await getFeatured();

/** Filter tabs on the home work grid map the five disciplines onto three groups. */
type WorkGroup = 'design' | 'marketing' | 'video';
const groupMap: Record<string, WorkGroup> = {
  'Graphic Design': 'design',
  'UI Design': 'design',
  'Digital Marketing': 'marketing',
  'Video Editing': 'video',
  'AI Creative Production': 'video',
};
// Filter by the project's primary discipline so each card lives under exactly one tab.
const groupOf = (work: Work): WorkGroup[] => {
  const g = groupMap[work.data.discipline];
  return g ? [g] : [];
};
const groups = [
  { key: 'all', label: 'All' },
  { key: 'design', label: 'Design' },
  { key: 'marketing', label: 'Marketing' },
  { key: 'video', label: 'Video & AI' },
] as const;
const groupCount = (key: string) =>
  key === 'all' ? featured.length : featured.filter((w) => groupOf(w).includes(key as WorkGroup)).length;

/** Scope figures shown in the stats band (relocated from the old Marketing chapter). */
const marketingFacts = chapters.find((c) => c.id === 'marketing')?.facts ?? [];

const siteUrl = new URL(href('/'), Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: site.name,
      alternateName: site.fullName,
      jobTitle: site.title,
      description: `${site.positioning.lead} ${site.positioning.tone}`,
      url: siteUrl,
      email: `mailto:${site.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Pune',
        addressRegion: 'Maharashtra',
        addressCountry: 'IN',
      },
      sameAs: [site.linkedin],
      alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
      knowsAbout: [
        'Graphic design',
        'UI design',
        'Digital marketing',
        'Social media marketing',
        'Search engine optimisation',
        'Video editing',
        'AI-assisted creative production',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: `${site.name}, ${site.title}`,
      url: siteUrl,
      author: { '@id': `${siteUrl}#person` },
    },
  ],
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <DotField tone="light" fade="bottom" />

    <div class="container hero-content">
      <div class="hero-grid">
        <div class="hero-head">
          <p class="hero-eyebrow eyebrow" data-reveal>
            <span class="dot" aria-hidden="true"></span>
            <span>Portfolio</span>
            <span aria-hidden="true">·</span>
            <span>{site.shortLocation}</span>
          </p>
          <p class="hero-tagline" data-reveal style="--reveal-delay: 0.08s">
            Creative &amp; Digital Marketing <span class="hero-tagline-accent">Professional</span>
          </p>
          <p class="hero-subline" data-reveal style="--reveal-delay: 0.12s">
            <span>Design · UI · Marketing · Video &amp; AI</span>
          </p>
        </div>
        <h1 class="hero-title visually-hidden" id="hero-title">
          {site.name}, {site.positioning.lead} {site.positioning.tone}
        </h1>

        <div class="hero-stage-area">
          <div class="hero-marquee" aria-hidden="true">
            <div class="marquee-track marquee-track--fill">
              {Array.from({ length: 10 }).map(() => <span>Prajwal&nbsp;</span>)}
            </div>
            <div class="marquee-track marquee-track--outline">
              {Array.from({ length: 10 }).map(() => <span>Vispute&nbsp;</span>)}
            </div>
          </div>

          <figure class="hero-portrait" aria-hidden="true">
            <Image
              src={portrait}
              alt=""
              widths={[640, 960, 1312]}
              sizes="(min-width: 1100px) 54vw, (min-width: 640px) 70vw, 88vw"
              quality={90}
              loading="eager"
              fetchpriority="high"
              data-fade
            />
          </figure>
        </div>
        <div class="hero-side" data-reveal style="--reveal-delay: 0.55s">
          <p class="eyebrow hero-what-i-do">
            <span class="rule" aria-hidden="true"></span>
            <span>What I do</span>
            <span class="rule" aria-hidden="true"></span>
          </p>
          <p class="hero-intro">
            I create impactful <strong>marketing campaigns</strong>, engaging social media content and digital
            experiences. I combine <strong>marketing strategy, creative design and technology</strong> to build
            meaningful brand communication and digital experiences.
          </p>
          <p class="hero-current">{site.hero.current}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#work" data-magnetic>
              View my work <span class="arrow" aria-hidden="true">↓</span>
            </a>
            <a class="btn btn-ghost" href="#contact" data-magnetic>Contact me</a>
          </div>
        </div>
      </div>
      <div class="hero-stage">
        <HeroStage />
      </div>
    </div>
  </section>

  <LogoStrip />

  <section class="section selected" id="work" aria-labelledby="work-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2 class="section-title" id="work-title" data-split>
          Selected work <span class="tone">across design, marketing and video.</span>
        </h2>
        <div class="section-aside">
          <p class="section-intro" data-reveal>
            Six projects that show the range: a product brochure, Meta ads, customer and tutorial videos, a landing page
            and social content. Each opens into a full case study.
          </p>
        </div>
      </header>

      {/* Discipline summary: short intro and tools for each area, no repeated project previews. */}
      <ul role="list" class="work-summary">
        {
          chapters.map((chapter) => (
            <li class="work-summary-item" id={chapter.id} data-reveal>
              <p class="work-summary-label mono">
                <span class="num">{chapter.number}</span> {chapter.label}
              </p>
              <p class="work-summary-intro">{chapter.intro}</p>
              <ul role="list" class="work-summary-tools">
                {chapter.toolGroups
                  ?.flatMap((g) => g.tools)
                  .slice(0, 6)
                  .map((tool) => (
                    <li class="tag">{tool}</li>
                  ))}
              </ul>
            </li>
          ))
        }
      </ul>

      {/* Filter tabs for the six featured projects. */}
      <div class="work-tabs" data-work-tabs>
        <p class="work-tabs-label mono" id="work-tabs-label">Filter</p>
        <div class="work-tab-buttons" role="group" aria-labelledby="work-tabs-label">
          {
            groups.map((g, i) => (
              <button type="button" class="work-tab" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={g.key}>
                {g.label} <span class="work-tab-count">{groupCount(g.key)}</span>
              </button>
            ))
          }
        </div>
        <p class="work-tab-status mono" data-tab-status role="status" aria-live="polite"></p>
      </div>

      <ul role="list" class="feature-grid" data-work-grid-home data-reveal-group>
        {
          featured.map((work, i) => (
            <li class="feature-item" data-group={groupOf(work).join(' ')} data-reveal>
              <ProjectCard work={work} number={i + 1} size="medium" eager={i < 2} morph />
            </li>
          ))
        }
      </ul>

      <p class="work-all">
        <a class="text-link" href={href('/work/')}>
          All {all.length} projects <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <section class="section stats" aria-labelledby="stats-title">
    <div class="container">
      <h2 class="visually-hidden" id="stats-title">Scope of the work</h2>
      <ul role="list" class="stats-grid" data-reveal-group>
        {
          marketingFacts.map((fact) => (
            <li class="stat" data-reveal>
              <span class="stat-value" data-count>
                {fact.value}
              </span>
              <span class="stat-label">{fact.label}</span>
              <span class="stat-where mono">{fact.where}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section experience" id="experience" aria-labelledby="experience-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Experience</p>
        <h2 class="section-title" id="experience-title" data-split>
          Experience <span class="tone">in design, marketing and research.</span>
        </h2>
        <p class="section-intro">
          Design and growth roles at two technology companies, after marketing internships in influencer research and
          financial services.
        </p>
      </header>
      <ExperienceTimeline roles={experience} />
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container">
      <div class="about-grid">
        <header class="about-head">
          <p class="eyebrow">About &amp; skills</p>
          <h2 class="section-title" id="about-title" data-split>
            About me <span class="tone">and how my MBA shapes the work.</span>
          </h2>
        </header>

        <div class="about-text" data-reveal>
          <p class="about-lead">
            I’m Prajwal, a creative and digital marketing professional in Pune. I studied business, with a BBA in Human
            Resource Management and then an MBA in Marketing Management.
          </p>
          <p>
            The MBA is why my design and marketing work overlap. Before I design anything, I want to know who it is for,
            which channel it will run on and what it should get people to do. That way a brochure, a Meta ad and a landing
            page work as parts of one plan.
          </p>
          <p>
            The creative side came first. I took the Government of Maharashtra Elementary and Intermediate Grade drawing
            examinations and ran an Instagram edits page before design became my work.
          </p>
          <p>
            I also work with AI-assisted tools: HyperFrames and Remotion for video, Kiro and Cursor for building, and
            Midjourney, Firefly, Grok, ChatGPT and Claude for images, video and copy.
          </p>
          <p>Away from work: football, drawing and AI art.</p>
        </div>

        <aside class="about-facts" aria-label="Education and certifications" data-reveal style="--reveal-delay: 0.1s">
          <div class="fact-block">
            <h3 class="mono">Education</h3>
            <ul role="list">
              {
                education.map((e) => (
                  <li>
                    <span class="fact-main">{e.degree}</span>
                    <span>{e.school}</span>
                    <span class="mono fact-when">{e.years}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="fact-block">
            <h3 class="mono">MBA research</h3>
            <p class="fact-main">{research.title}</p>
            <ul class="fact-points">
              {research.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <div class="fact-block">
            <h3 class="mono">Certifications</h3>
            <ul role="list">
              {certifications.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div class="fact-block">
            <h3 class="mono">Leadership &amp; events</h3>
            <ul role="list">
              <li>Led IGNITE Maharashtra</li>
              <li>Managed and led the ODOP – DIC Maharashtra Government event</li>
              <li>Marketing team, Mahasangram Fest 2K25: lead generation and event management</li>
            </ul>
          </div>
        </aside>
      </div>

      <div class="skills-block" id="skills">
        <h3 class="skills-title" data-split>
          Skills &amp; tools <span class="tone">grouped by discipline.</span>
        </h3>
        <SkillsGrid />
      </div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    /* The name marquee escapes the container to 100vw; clip keeps it edge-to-edge
       while preventing any sideways scrollbar at every width. */
    overflow-x: clip;
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }

  /* Label + tagline + sub line, grouped so their spacing is exact and independent
     of the hero grid row-gap. Sits above the marquee, left-aligned to the nav. */
  .hero-head {
    grid-column: 1 / -1;
    position: relative;
    z-index: 3;
  }

  .hero-tagline {
    margin-top: 8px;
    font-family: var(--sans);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    font-size: clamp(24px, 1.95vw, 34px);
    color: #141414;
  }

  /* Keep the title on a single line on desktop; it wraps only when too narrow. */
  @media (min-width: 900px) {
    .hero-tagline {
      white-space: nowrap;
    }
  }

  .hero-tagline-accent {
    color: var(--accent);
  }

  .hero-subline {
    margin-top: 6px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 32px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(16px, 1.3vw, 22px);
    color: #6b6b6b;
  }

  /* Thin rule trailing the sub line, vertically centred with the text. */
  .hero-subline::after {
    content: '';
    flex: 0 0 auto;
    height: 1px;
    width: clamp(100px, 11vw, 190px);
    background: #bdbdbd;
  }

  @media (max-width: 640px) {
    .hero-subline::after {
      display: none;
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    position: relative;
  }

  .hero-grid {
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .hero-eyebrow {
    grid-column: 1 / -1;
    color: var(--ink-2);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Stage area holds the character and the two-line marquee behind it. */
  .hero-stage-area {
    grid-column: 1 / -1;
    grid-row: 2;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: min(72vh, 36rem);
  }

  /* The marquee extends to the viewport edges by escaping the container padding.
     PRAJWAL fills with charcoal; VISPUTE is outlined. Both scroll right-to-left at
     slightly different speeds for a layered parallax feel. */
  .hero-marquee {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 50vw);
    right: calc(50% - 50vw);
    width: 100vw;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    mask-image: linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    flex-shrink: 0;
    font-size: clamp(5rem, 22vw, 18rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.055em;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform;
    animation: hero-marquee 55s linear infinite;
  }

  .marquee-track > :global(span) {
    display: inline-block;
    padding-right: 0.08em;
    flex-shrink: 0;
  }

  .marquee-track--fill {
    color: var(--ink);
  }

  .marquee-track--outline {
    margin-top: -0.22em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink-2);
    text-stroke: 1.5px var(--ink-2);
    animation-duration: 42s;
  }

  @keyframes hero-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (max-width: 640px) {
    .marquee-track {
      font-size: clamp(4rem, 30vw, 10rem);
      animation-duration: 32s;
    }

    .marquee-track--outline {
      animation-duration: 24s;
      -webkit-text-stroke-width: 1px;
      text-stroke-width: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  /* Character sits in front of the marquee, centered inside the stage area. */
  .hero-portrait {
    position: relative;
    display: block;
    width: auto;
    max-width: min(88vw, 60rem);
    z-index: 2;
    margin: 0;
    pointer-events: none;
  }

  .hero-portrait :global(img) {
    width: 100%;
    height: auto;
    max-height: 72vh;
    object-fit: contain;
    display: block;
  }

  /* "What I do" intro, centered under the character. The intro paragraph takes up to
     95vw / 1450px to read as a single wide editorial sentence; the eyebrow, current-role
     line and CTAs stay their own, narrower widths via their own max-widths. */
  .hero-side {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    gap: clamp(1rem, 2.2vw, 1.5rem);
    justify-self: center;
    justify-items: center;
    text-align: center;
    width: min(95%, 90.625rem);
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
  }

  .hero-what-i-do {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .hero-what-i-do .rule {
    display: block;
    width: 1.75rem;
    height: 1px;
    background: var(--rule-strong);
  }

  /* Intro paragraph: 21px on desktop, natural wrapping to ~3 wide lines at the 95vw
     measure. justify-self: stretch is needed because the parent grid centers its
     children to their content width; without it, the paragraph would stay narrow. */
  .hero-intro {
    justify-self: stretch;
    width: 100%;
    font-size: clamp(1.0625rem, 0.95rem + 0.6vw, 1.3125rem);
    line-height: 1.5;
    color: var(--ink);
    font-weight: 400;
    text-wrap: pretty;
  }

  /* Reserved for marketing campaigns and the three-skills phrase. */
  .hero-intro strong {
    font-weight: 600;
    color: var(--ink);
  }

  .hero-current {
    max-width: 42rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .hero-stage {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* Selected work */
  .selected {
    border-top: 1px solid var(--rule);
  }

  /* Discipline summary strip: replaces the old category sections and accordions. */
  .work-summary {
    display: grid;
    gap: var(--gap);
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 760px) {
    .work-summary {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .work-summary-item {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .work-summary-label {
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .work-summary-label .num {
    color: var(--accent);
  }

  .work-summary-intro {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .work-summary-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.1rem;
  }

  /* Filter tabs. */
  .work-tabs {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
    padding-block: 1rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .work-tabs-label {
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .work-tab-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .work-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    font-size: var(--step--1);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .work-tab:hover {
    border-color: var(--ink);
  }

  .work-tab[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .work-tab-count {
    font-family: var(--mono);
    font-size: var(--step--2);
    opacity: 0.7;
  }

  .work-tab-status {
    min-height: 1.3em;
    font-size: var(--step--2);
    color: var(--muted);
  }

  /* Even project grid: one consistent card size and aspect ratio. */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) var(--gap);
  }

  .feature-item[hidden] {
    display: none;
  }

  .work-all {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
    font-size: var(--step-1);
  }

  /* Stats band (scope figures, big number + short label). */
  .stats {
    border-top: 1px solid var(--rule);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .stats-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .stat {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .stat-value {
