---
import Chapter from '../components/Chapter.astro';
import ContactBlock from '../components/ContactBlock.astro';
import DotField from '../components/DotField.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import HeroStage from '../components/HeroStage.astro';
import LogoStrip from '../components/LogoStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import { chapters } from '../data/chapters';
import { certifications, education, experience, research } from '../data/experience';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/paths';
import { getFeatured, getWork } from '../lib/work';

const all = await getWork();
const featured = await getFeatured();
const numberOf = (id: string) => all.findIndex((w) => w.id === id) + 1;

const siteUrl = new URL(href('/'), Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: site.name,
      alternateName: site.fullName,
      jobTitle: site.title,
      description: `${site.positioning.lead} ${site.positioning.tone}`,
      url: siteUrl,
      email: `mailto:${site.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Pune',
        addressRegion: 'Maharashtra',
        addressCountry: 'IN',
      },
      sameAs: [site.linkedin],
      alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
      knowsAbout: [
        'Graphic design',
        'UI design',
        'Digital marketing',
        'Social media marketing',
        'Search engine optimisation',
        'Video editing',
        'AI-assisted creative production',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: `${site.name}, ${site.title}`,
      url: siteUrl,
      author: { '@id': `${siteUrl}#person` },
    },
  ],
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <DotField tone="light" fade="bottom" />
    <div class="container hero-content">
      <div class="hero-grid">
        <p class="hero-eyebrow eyebrow" data-reveal>
          <span class="dot" aria-hidden="true"></span>
          <span>Portfolio</span>
          <span aria-hidden="true">·</span>
          <span>{site.shortLocation}</span>
        </p>
        <h1 class="hero-title" id="hero-title">
          <span class="hero-name" data-split>{site.name}</span>
          <span class="hero-position" data-split style="--split-delay: 0.35s">
            {site.positioning.lead} <span class="tone">{site.positioning.tone}</span>
          </span>
        </h1>
        <div class="hero-side" data-reveal style="--reveal-delay: 0.55s">
          <p class="hero-intro">{site.hero.intro}</p>
          <p class="hero-current">{site.hero.current}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#work" data-magnetic>
              View my work <span class="arrow" aria-hidden="true">↓</span>
            </a>
            <a class="btn btn-ghost" href="#contact" data-magnetic>Contact me</a>
          </div>
        </div>
      </div>
      <div class="hero-stage">
        <HeroStage />
      </div>
    </div>
  </section>

  <LogoStrip />

  <section class="section selected" id="work" aria-labelledby="work-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2 class="section-title" id="work-title" data-split>
          Selected work <span class="tone">across design, marketing and video.</span>
        </h2>
        <div class="section-aside">
          <p class="section-intro">
            Six projects that show the range: a product brochure, Meta ads, customer and tutorial videos, a landing page and
            social content. Each opens into a full case study.
          </p>
          <p class="aside-link">
            <a class="text-link" href={href('/work/')}>
              All {all.length} projects <span class="arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </header>

      <ul role="list" class="feature-grid">
        {
          featured.map((work, i) => {
            const large = i % 4 === 0 || i % 4 === 3;
            return (
              <li class="feature-item" data-reveal>
                <ProjectCard
                  work={work}
                  number={numberOf(work.id)}
                  size={large ? 'large' : 'medium'}
                  eager={i < 2}
                  morph
                />
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {chapters.map((chapter) => <Chapter chapter={chapter} />)}

  <section class="section experience" id="experience" aria-labelledby="experience-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Experience</p>
        <h2 class="section-title" id="experience-title" data-split>
          Experience <span class="tone">in design, marketing and research.</span>
        </h2>
        <p class="section-intro">
          Design and growth roles at two technology companies, after marketing internships in influencer research and
          financial services.
        </p>
      </header>
      <ExperienceTimeline roles={experience} />
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container">
      <div class="about-grid">
        <header class="about-head">
          <p class="eyebrow">About &amp; skills</p>
          <h2 class="section-title" id="about-title" data-split>
            About me <span class="tone">and how my MBA shapes the work.</span>
          </h2>
        </header>

        <div class="about-text" data-reveal>
          <p class="about-lead">
            I’m Prajwal, a creative and digital marketing professional in Pune. I studied business, with a BBA in Human
            Resource Management and then an MBA in Marketing Management.
          </p>
          <p>
            The MBA is why my design and marketing work overlap. Before I design anything, I want to know who it is for,
            which channel it will run on and what it should get people to do. That way a brochure, a Meta ad and a landing
            page work as parts of one plan.
          </p>
          <p>
            The creative side came first. I took the Government of Maharashtra Elementary and Intermediate Grade drawing
            examinations and ran an Instagram edits page before design became my work.
          </p>
          <p>
            I also work with AI-assisted tools: HyperFrames and Remotion for video, Kiro and Cursor for building, and
            Midjourney, Firefly, Grok, ChatGPT and Claude for images, video and copy.
          </p>
          <p>Away from work: football, drawing and AI art.</p>
        </div>

        <aside class="about-facts" aria-label="Education and certifications" data-reveal style="--reveal-delay: 0.1s">
          <div class="fact-block">
            <h3 class="mono">Education</h3>
            <ul role="list">
              {
                education.map((e) => (
                  <li>
                    <span class="fact-main">{e.degree}</span>
                    <span>{e.school}</span>
                    <span class="mono fact-when">{e.years}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="fact-block">
            <h3 class="mono">MBA research</h3>
            <p class="fact-main">{research.title}</p>
            <ul class="fact-points">
              {research.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <div class="fact-block">
            <h3 class="mono">Certifications</h3>
            <ul role="list">
              {certifications.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div class="fact-block">
            <h3 class="mono">Leadership &amp; events</h3>
            <ul role="list">
              <li>Led IGNITE Maharashtra</li>
              <li>Managed and led the ODOP – DIC Maharashtra Government event</li>
              <li>Marketing team, Mahasangram Fest 2K25: lead generation and event management</li>
            </ul>
          </div>
        </aside>
      </div>

      <div class="skills-block" id="skills">
        <h3 class="skills-title" data-split>
          Skills &amp; tools <span class="tone">grouped by discipline.</span>
        </h3>
        <SkillsGrid />
      </div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .hero-eyebrow {
    grid-column: 1 / -1;
    color: var(--ink-2);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero-title {
    grid-column: 1 / -1;
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .hero-name {
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin-left: -0.04em;
  }

  .hero-position {
    max-width: 24ch;
    font-size: var(--step-3);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .hero-side {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
    align-content: end;
  }

  .hero-intro {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .hero-current {
    max-width: 34rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 1100px) {
    .hero-title {
      grid-column: 1 / span 7;
    }

    .hero-side {
      grid-column: 8 / span 5;
      padding-bottom: 0.4rem;
    }
  }

  .hero-stage {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* Selected work */
  .selected {
    border-top: 1px solid var(--rule);
  }

  .aside-link {
    margin-top: 1rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 6vw, 5rem) var(--gap);
  }

  @media (min-width: 640px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    .feature-item:nth-child(4n + 1) {
      grid-column: 1 / span 7;
    }

    .feature-item:nth-child(4n + 2) {
      grid-column: 8 / span 5;
      align-self: end;
    }

    .feature-item:nth-child(4n + 3) {
      grid-column: 1 / span 5;
      align-self: end;
    }

    .feature-item:nth-child(4n + 4) {
      grid-column: 6 / span 7;
    }
  }

  /* Experience */
  .experience {
    border-top: 1px solid var(--rule);
  }

  /* About */
  .about {
    border-top: 1px solid var(--rule);
  }

  .about-grid {
    display: grid;
    gap: 2.5rem var(--gap);
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .about-head,
  .about-text,
  .about-facts {
    grid-column: 1 / -1;
  }

  .about-head {
    display: grid;
    gap: 1.25rem;
  }

  .about-head .section-title {
    grid-column: auto;
  }

  .about-text {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    max-width: 40rem;
    font-size: var(--step-1);
    color: var(--ink-2);
  }

  .about-lead {
    font-size: var(--step-2);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .about-facts {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  @media (min-width: 1000px) {
    .about-text {
      grid-column: 1 / span 7;
    }

    .about-facts {
      grid-column: 9 / span 4;
    }
  }

  .fact-block {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .fact-block h3 {
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fact-block ul[role='list'] {
    display: grid;
    gap: 0.75rem;
  }

  .fact-block li {
    display: grid;
    gap: 0.1rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .fact-main {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--ink);
  }

  .fact-when {
    color: var(--muted);
  }

  .fact-points {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .fact-points li {
    display: list-item;
  }

  .skills-block {
    display: grid;
    gap: 1.75rem;
    margin-top: clamp(4rem, 8vw, 6.5rem);
  }

  .skills-title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }
</style>
