---
/**
 * Experience, newest first, each with the company's official logo.
 * The first role (FotoOwl) is shown as a featured dark card with its case studies.
 * Projects are matched to roles by company name.
 */
import type { Role } from '../data/experience';
import { logoFor } from '../data/companies';
import { workHref } from '../lib/paths';
import { getWork, slugify } from '../lib/work';
import CompanyLogo from './CompanyLogo.astro';
import ProjectIndex from './ProjectIndex.astro';

interface Props {
  roles: Role[];
  /** Company whose entry is shown as a featured card. */
  featured?: string;
}

const { roles, featured = 'FotoOwl' } = Astro.props;
const works = await getWork();
const now = new Date();

/** "Present" or an end month in the future means the role is current. */
function isCurrent(end: string): boolean {
  if (/present/i.test(end)) return true;
  const parsed = new Date(`1 ${end}`);
  if (Number.isNaN(parsed.getTime())) return false;
  const endOfMonth = new Date(parsed.getFullYear(), parsed.getMonth() + 1, 0, 23, 59, 59);
  return endOfMonth >= now;
}

const entries = roles.map((role) => {
  const related = works.filter((w) => w.data.company === role.company);
  return {
    role,
    id: `experience-${slugify(role.company)}`,
    logo: logoFor(role.company),
    related,
    current: isCurrent(role.end),
    featured: role.company === featured,
  };
});
---

<ol role="list" class="timeline">
  {
    entries.map(({ role, id, logo, related, current, featured: isFeatured }) => (
      <li class:list={['entry', { 'entry--featured': isFeatured }]} id={id} data-reveal>
        <div class="entry-when mono">
          <span>
            {role.start} <span aria-hidden="true">–</span>
            <span class="visually-hidden">to</span> {role.end}
          </span>
          {current && <span class="current-chip">Current</span>}
        </div>

        <div class="entry-main">
          <div class="entry-head">
            <CompanyLogo company={role.company} surface={isFeatured ? 'dark' : 'light'} tile={!isFeatured} height={isFeatured ? 30 : 20} alt={`${role.company} logo`} />
            <div class="entry-titles">
              <h3 class="entry-role">{role.role}</h3>
              <p class="entry-company">
                {role.location ? `${role.company}, ${role.location}` : role.company}
                {logo?.url && (
                  <>
                    {' '}
                    <span aria-hidden="true">·</span>{' '}
                    <a class="entry-site" href={logo.url} target="_blank" rel="noopener">
                      {logo.urlLabel}
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  </>
                )}
              </p>
            </div>
          </div>

          <ul class="entry-points">
            {role.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>

          {isFeatured && related.length > 0 && (
            <div class="entry-cases">
              <p class="entry-label mono">
                {related.length} case studies from this internship
              </p>
              <ProjectIndex items={related} tone="dark" compact />
            </div>
          )}

          {!isFeatured && related.length > 0 && (
            <div class="entry-related">
              <p class="entry-label mono">Related work</p>
              <ul role="list">
                {related.map((work) => (
                  <li>
                    <a class="text-link" href={workHref(work.id)}>
                      {work.data.shortTitle ?? work.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink);
  }

  .entry {
    display: grid;
    gap: 1rem 2rem;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 900px) {
    .entry {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }
  }

  .entry--featured {
    margin-block: 1.5rem 0.5rem;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--night);
    color: var(--on-night);
  }

  .entry-when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    align-self: start;
    padding-top: 0.35rem;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .entry--featured .entry-when {
    color: var(--on-night-muted);
  }

  .current-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: var(--step--2);
  }

  .current-chip::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #2f9e63;
  }

  .entry-main {
    display: grid;
    gap: 1rem;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.25rem;
  }

  .entry-titles {
    display: grid;
    gap: 0.2rem;
  }

  .entry-role {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }

  .entry-company {
    font-weight: 500;
    color: var(--ink-2);
  }

  .entry--featured .entry-company {
    color: var(--on-night-muted);
  }

  .entry-site {
    font-weight: 400;
    color: var(--muted);
  }

  .entry--featured .entry-site {
    color: var(--on-night-muted);
  }

  .entry-site:hover {
    color: var(--accent);
  }

  .entry--featured .entry-site:hover {
    color: var(--accent-on-night);
  }

  .entry-points {
    display: grid;
    gap: 0.5rem 2.5rem;
    margin: 0.25rem 0 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
  }

  .entry--featured .entry-points {
    color: var(--on-night);
  }

  .entry-points li::marker {
    color: var(--rule-strong);
  }

  .entry--featured .entry-points li::marker {
    color: var(--accent-on-night);
  }

  @media (min-width: 1100px) {
    .entry-points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .entry-label {
    margin-bottom: 0.75rem;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .entry--featured .entry-label {
    color: var(--on-night-muted);
  }

  .entry-cases {
    margin-top: 1rem;
  }

  .entry-related {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule);
  }

  .entry-related ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .entry--featured :focus-visible {
    outline-color: var(--accent-on-night);
  }
</style>
