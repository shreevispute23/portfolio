---
/**
 * Click-to-play video with a poster. Nothing downloads until the visitor presses play.
 * Shows loading and "unavailable" states; only one video plays at a time.
 */
import { getImage, type ImageMetadata } from 'astro:assets';
import { asset } from '../lib/paths';

interface Props {
  src: string;
  poster: ImageMetadata;
  title: string;
  orientation: 'landscape' | 'portrait';
  duration: string;
  caption?: string;
}

const { src, poster, title, orientation, duration, caption } = Astro.props;
const posterImage = await getImage({
  src: poster,
  width: Math.min(poster.width, orientation === 'portrait' ? 720 : 1280),
  format: 'webp',
  quality: 78,
});
const file = asset(`/media/video/${src}`);
const format = orientation === 'portrait' ? 'Vertical 9:16' : 'Landscape 16:9';
---

<figure class:list={['video', `video--${orientation}`]} data-video>
  <div class="video-frame" style={`aspect-ratio: ${poster.width} / ${poster.height};`}>
    <video controls preload="none" playsinline poster={posterImage.src} aria-label={title} data-video-el>
      <source src={file} type="video/mp4" />
      <p>
        This browser cannot play the video. <a href={file}>Download it</a> instead.
      </p>
    </video>
    <button class="video-play" type="button" data-video-play hidden>
      <span class="video-play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
      </span>
      <span class="video-play-label">Play<span class="visually-hidden">: {title}</span></span>
      <span class="video-play-time mono" aria-hidden="true">{duration}</span>
    </button>
    <p class="video-state mono" data-video-state role="status" hidden></p>
  </div>
  <figcaption>
    <span class="video-title">{title}</span>
    <span class="video-meta mono">{format} · {duration} · Captions in video</span>
    {caption && <span class="video-caption">{caption}</span>}
  </figcaption>
</figure>

<style>
  .video {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .video-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--night);
  }

  .video--portrait .video-frame {
    max-height: 82vh;
    margin-inline: auto;
    width: 100%;
  }

  .video-frame video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--night);
  }

  .video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem 0.55rem 0.55rem;
    border: 0;
    border-radius: 999px;
    background: rgba(243, 241, 236, 0.94);
    color: var(--ink);
    font-weight: 600;
    cursor: pointer;
    transform: translate(-50%, -50%);
    box-shadow: 0 0.75rem 2rem -0.75rem rgba(0, 0, 0, 0.5);
    transition:
      transform 0.3s var(--ease),
      background-color 0.25s var(--ease);
  }

  .video-play:hover {
    transform: translate(-50%, -50%) scale(1.04);
    background: #fff;
  }

  .video-play-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
  }

  .video-play-time {
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }

  .video-state {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgba(19, 19, 18, 0.85);
    color: var(--on-night);
    font-size: var(--step--2);
    pointer-events: none;
  }

  .video-state[data-tone='error'] {
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 0;
    background: rgba(19, 19, 18, 0.88);
    font-size: var(--step--1);
    text-align: center;
    padding: 1.5rem;
  }

  figcaption {
    display: grid;
    gap: 0.2rem;
  }

  .video-title {
    font-weight: 600;
    line-height: 1.3;
  }

  .video-meta {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .video-caption {
    padding-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
</style>

<script>
  const players = document.querySelectorAll<HTMLElement>('[data-video]');

  players.forEach((figure) => {
    const video = figure.querySelector<HTMLVideoElement>('[data-video-el]');
    const button = figure.querySelector<HTMLButtonElement>('[data-video-play]');
    const state = figure.querySelector<HTMLElement>('[data-video-state]');
    if (!video || !button || !state) return;

    const setState = (text: string, tone: 'info' | 'error' = 'info') => {
      state.textContent = text;
      state.dataset.tone = tone;
      state.hidden = !text;
    };

    // Enhanced player: hide native controls until the first play.
    video.controls = false;
    button.hidden = false;

    button.addEventListener('click', () => {
      video.controls = true;
      button.hidden = true;
      setState('Loading video…');
      video.play().catch(() => {
        /* The browser may block playback; controls remain available. */
      });
    });

    video.addEventListener('play', () => {
      button.hidden = true;
      video.controls = true;
      document.querySelectorAll<HTMLVideoElement>('[data-video-el]').forEach((other) => {
        if (other !== video && !other.paused) other.pause();
      });
    });
    video.addEventListener('waiting', () => setState('Loading video…'));
    video.addEventListener('playing', () => setState(''));
    video.addEventListener('canplay', () => {
      if (!video.paused) setState('');
    });
    video.addEventListener('ended', () => {
      button.hidden = false;
    });

    const fail = () => {
      button.hidden = true;
      video.controls = false;
      setState('This video could not be loaded. Please try again later.', 'error');
    };
    video.addEventListener('error', fail);
    video.querySelector('source')?.addEventListener('error', fail);
  });
</script>
