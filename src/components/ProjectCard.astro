---
import { Image } from 'astro:assets';
import { asset, workHref } from '../lib/paths';
import { disciplinesOf, hasVideo, indexLabel, type Work } from '../lib/work';

interface Props {
  work: Work;
  /** Position in the full project list, shown as 01, 02 ... */
  number: number;
  size?: 'large' | 'medium';
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
  /** Give the cover a view-transition name so it morphs into the case study cover.
   *  Only use where the project appears once on the page. */
  morph?: boolean;
}

const { work, number, size = 'medium', headingLevel = 'h3', eager = false, morph = false } = Astro.props;
const d = work.data;
const Heading = headingLevel;
const disciplines = disciplinesOf(work);
const sizes =
  size === 'large'
    ? '(min-width: 1440px) 760px, (min-width: 900px) 56vw, 94vw'
    : '(min-width: 1440px) 560px, (min-width: 900px) 42vw, (min-width: 640px) 46vw, 94vw';
const preview = d.previewVideo ? asset(`/media/preview/${d.previewVideo}`) : undefined;
---

<article
  class:list={['card', `card--${size}`, { 'card--soon': d.status === 'coming-soon' }]}
  data-disciplines={disciplines.join('|')}
  data-card
>
  <div
    class="card-media media-frame"
    style={morph ? `view-transition-name: work-${work.id}` : undefined}
    data-mask
    data-parallax
  >
    {
      d.cover ? (
        <Image
          src={d.cover}
          alt={d.coverAlt ?? ''}
          widths={[480, 800, 1200, 1600]}
          sizes={sizes}
          quality={78}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          data-fade
        />
      ) : (
        <div class="card-empty" aria-hidden="true">
          <span class="mono">Media coming soon</span>
        </div>
      )
    }
    {
      preview && (
        <video class="card-video" muted loop playsinline preload="none" aria-hidden="true" data-card-video data-src={preview} />
      )
    }
    <div class="card-badges">
      {d.status === 'coming-soon' && <span class="tag tag-solid">Coming soon</span>}
      {d.status === 'in-progress' && <span class="tag tag-light">More media to add</span>}
      {hasVideo(work) && <span class="tag tag-light">Video</span>}
    </div>
    <span class="card-cta" aria-hidden="true">
      View case study <span class="arrow">→</span>
    </span>
  </div>
  <div class="card-body">
    <p class="card-meta mono">
      <span class="num">{indexLabel(number)}</span>
      <span>{d.company}</span>
      <span aria-hidden="true">/</span>
      <span>{d.discipline}</span>
    </p>
    <Heading class="card-title">
      <a href={workHref(work.id)} data-astro-prefetch>
        {d.title}
      </a>
    </Heading>
    <p class="card-summary">{d.summary}</p>
    {
      d.channels.length > 0 && (
        <p class="card-channels mono">
          <span class="visually-hidden">Channels: </span>
          {d.channels.join(' · ')}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .card-media {
    aspect-ratio: 3 / 2;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .card:hover .card-media,
  .card:focus-within .card-media {
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-lift);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease),
      opacity 0.6s var(--ease);
  }

  .card:hover .card-media :global(img),
  .card:focus-within .card-media :global(img) {
    transform: scale(1.025);
  }

  .card-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--night);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .card-video.is-playing {
    opacity: 1;
  }

  .card-empty {
    display: grid;
    place-items: center;
    height: 100%;
    background:
      repeating-linear-gradient(-45deg, transparent 0 11px, rgba(23, 23, 23, 0.04) 11px 12px),
      var(--paper-2);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .card-badges {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card-cta {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step--1);
    font-weight: 500;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .card:hover .card-cta,
  .card:focus-within .card-cta {
    opacity: 1;
    transform: none;
  }

  .card-body {
    display: grid;
    gap: 0.5rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .card-meta .num {
    color: var(--accent);
  }

  .card-title {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }

  .card--large .card-title {
    font-size: var(--step-3);
  }

  .card-title a {
    text-decoration: none;
  }

  /* The title link covers the whole card: one link and one tab stop per card. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card:has(.card-title a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 4px;
  }

  .card:hover .card-title a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .card-summary {
    max-width: 36rem;
    color: var(--ink-2);
  }

  .card-channels {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-cta {
      transform: none;
    }

    .card:hover .card-media :global(img) {
      transform: none;
    }
  }
</style>

<script>
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);

  document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>('[data-card-video]');
    if (!video) return;
    video.addEventListener('playing', () => video.classList.add('is-playing'));
    card.addEventListener('pointerenter', () => {
      if (!fine.matches || reduce.matches || saveData) return;
      if (!video.src && video.dataset.src) video.src = video.dataset.src;
      video.play().catch(() => {
        /* Autoplay can be blocked; the cover stays visible. */
      });
    });
    card.addEventListener('pointerleave', () => {
      video.pause();
      video.classList.remove('is-playing');
    });
  });
</script>
