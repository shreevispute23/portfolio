---
/**
 * Animated pixel-grid background, drawn on a canvas behind a section's content.
 * - A slow wave travels across the grid, with the odd pixel twinkling.
 * - Pixels near the mouse grow, warm to the accent colour and ease away from the pointer.
 * - A click or tap sends a ripple through the grid.
 * It pauses when off screen or in a background tab, and is static when the visitor
 * prefers reduced motion. The parent element needs `position: relative`.
 */
interface Props {
  tone?: 'light' | 'dark';
  /** Distance between pixels in CSS px. */
  spacing?: number;
  /** Where the field fades out so it never competes with text. */
  fade?: 'bottom' | 'right' | 'radial';
  class?: string;
}

const { tone = 'light', spacing = 22, fade = 'bottom', class: className } = Astro.props;
---

<div
  class:list={['dotfield', `dotfield--fade-${fade}`, className]}
  data-dotfield
  data-tone={tone}
  data-spacing={spacing}
  aria-hidden="true"
>
  <canvas></canvas>
</div>

<style>
  .dotfield {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .dotfield canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .dotfield--fade-bottom {
    mask-image: linear-gradient(to bottom, #000 0%, #000 42%, transparent 88%);
  }

  .dotfield--fade-right {
    mask-image: linear-gradient(to left, #000 0%, #000 25%, transparent 80%);
  }

  .dotfield--fade-radial {
    mask-image: radial-gradient(ellipse 70% 70% at 65% 40%, #000 20%, transparent 78%);
  }

  @media print {
    .dotfield {
      display: none;
    }
  }
</style>

<script>
  type Palette = { dot: [number, number, number]; accent: [number, number, number]; base: number; glow: number };

  const palettes: Record<string, Palette> = {
    light: { dot: [23, 23, 23], accent: [191, 63, 23], base: 0.12, glow: 0.62 },
    dark: { dot: [239, 239, 234], accent: [242, 104, 60], base: 0.1, glow: 0.75 },
  };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const RADIUS = 170;
  const RIPPLE_MS = 1500;

  document.querySelectorAll<HTMLElement>('[data-dotfield]').forEach((root) => {
    const canvas = root.querySelector('canvas');
    const ctx = canvas?.getContext('2d');
    // Pointer events are read from the nearest marked host, or the parent element.
    const host = root.closest<HTMLElement>('[data-dotfield-host]') ?? root.parentElement;
    if (!canvas || !ctx || !host) return;

    const pal = palettes[root.dataset.tone ?? 'light'] ?? palettes.light;
    const spacing = Number(root.dataset.spacing) || 22;
    const baseColor = `rgb(${pal.dot.join(',')})`;
    let width = 0;
    let height = 0;
    let points = new Float32Array(0);
    const pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999, strength: 0, target: 0 };
    const ripples: { x: number; y: number; start: number }[] = [];
    let inView = false;
    let frame = 0;
    let lastDraw = 0;

    const draw = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      const still = reduce.matches;

      pointer.x += (pointer.tx - pointer.x) * 0.2;
      pointer.y += (pointer.ty - pointer.y) * 0.2;
      pointer.strength += (pointer.target - pointer.strength) * 0.08;
      for (let i = ripples.length - 1; i >= 0; i--) {
        if (time - ripples[i].start > RIPPLE_MS) ripples.splice(i, 1);
      }

      ctx.fillStyle = baseColor;
      const r2 = RADIUS * RADIUS;
      for (let k = 0; k < points.length; k += 3) {
        let x = points[k];
        let y = points[k + 1];
        let size = 1.6;
        let alpha = pal.base;
        let warmth = 0;

        if (!still) {
          const wave = Math.sin(x * 0.011 + y * 0.007 - time * 0.0006);
          const twinkle = Math.sin(time * 0.0011 + points[k + 2] * 9);
          size += wave * 0.4;
          alpha += wave * 0.035 + (twinkle > 0.96 ? (twinkle - 0.96) * 9 * pal.base : 0);

          if (pointer.strength > 0.01) {
            const dx = x - pointer.x;
            const dy = y - pointer.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < r2) {
              const d = Math.sqrt(d2) || 1;
              const falloff = 1 - d / RADIUS;
              const e = falloff * falloff * pointer.strength;
              size += e * 2.6;
              alpha += e * pal.glow;
              warmth = e;
              x += (dx / d) * e * 8;
              y += (dy / d) * e * 8;
            }
          }

          for (const ripple of ripples) {
            const age = (time - ripple.start) / RIPPLE_MS;
            const ring = age * 560;
            const d = Math.hypot(points[k] - ripple.x, points[k + 1] - ripple.y);
            const band = 1 - Math.abs(d - ring) / 46;
            if (band > 0) {
              const e = band * (1 - age);
              size += e * 2.2;
              alpha += e * pal.glow * 0.8;
              warmth = Math.max(warmth, e);
            }
          }
        }

        ctx.globalAlpha = Math.min(1, Math.max(0, alpha));
        if (warmth > 0.02) {
          const c = pal.dot.map((v, i) => Math.round(v + (pal.accent[i] - v) * Math.min(1, warmth * 1.4)));
          ctx.fillStyle = `rgb(${c[0]},${c[1]},${c[2]})`;
          ctx.fillRect(x - size / 2, y - size / 2, size, size);
          ctx.fillStyle = baseColor;
        } else {
          ctx.fillRect(x - size / 2, y - size / 2, size, size);
        }
      }
      ctx.globalAlpha = 1;
    };

    const loop = (time: number) => {
      frame = 0;
      if (!inView || document.hidden || reduce.matches) return;
      const active = pointer.strength > 0.01 || pointer.target > 0 || ripples.length > 0;
      // About 30 fps while idle, full rate while the visitor interacts.
      if (active || time - lastDraw > 32) {
        draw(time);
        lastDraw = time;
      }
      frame = requestAnimationFrame(loop);
    };

    const start = () => {
      if (!frame && inView && !document.hidden && !reduce.matches) frame = requestAnimationFrame(loop);
    };

    const resize = () => {
      const rect = root.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      // Sharp on high-density screens, but capped so large sections stay light on memory.
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      while (dpr > 1 && width * height * dpr * dpr > 4.5e6) dpr -= 0.25;
      canvas.width = Math.max(1, Math.round(width * dpr));
      canvas.height = Math.max(1, Math.round(height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const cols = Math.ceil(width / spacing) + 1;
      const rows = Math.ceil(height / spacing) + 1;
      const ox = (width - (cols - 1) * spacing) / 2;
      const oy = (height - (rows - 1) * spacing) / 2;
      points = new Float32Array(cols * rows * 3);
      let k = 0;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const n = Math.sin(c * 12.9898 + r * 78.233) * 43758.5453;
          points[k++] = ox + c * spacing;
          points[k++] = oy + r * spacing;
          points[k++] = n - Math.floor(n);
        }
      }
      draw(performance.now());
    };

    new ResizeObserver(resize).observe(root);
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      start();
    }).observe(root);
    document.addEventListener('visibilitychange', start);
    reduce.addEventListener('change', () => {
      draw(performance.now());
      start();
    });

    const local = (event: PointerEvent) => {
      const rect = root.getBoundingClientRect();
      return { x: event.clientX - rect.left, y: event.clientY - rect.top };
    };
    host.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
      const p = local(event);
      if (pointer.target === 0) {
        pointer.x = p.x;
        pointer.y = p.y;
      }
      pointer.tx = p.x;
      pointer.ty = p.y;
      pointer.target = 1;
      start();
    });
    host.addEventListener('pointerleave', () => {
      pointer.target = 0;
    });
    host.addEventListener('pointerdown', (event) => {
      if (reduce.matches) return;
      const p = local(event);
      ripples.push({ x: p.x, y: p.y, start: performance.now() });
      if (ripples.length > 4) ripples.shift();
      start();
    });
  });
</script>
