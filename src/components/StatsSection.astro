---
/**
 * "Impact in numbers" — the three stats, redesigned as a dark full-bleed bento band.
 * Facts are unchanged from the site data; only the visible captions are shortened, with
 * the full original sentence kept in a visually hidden span for screen readers.
 * Numbers are rendered to their final value so they are correct even if JS never runs.
 * Motion lives in src/scripts/motion/impact.js (loaded by motion/index.js).
 */
const dots = Array.from({ length: 100 }, (_, i) => (Math.floor(i / 10) + (i % 10)) * 80);
---

<section class="impact" id="impact" aria-labelledby="impact-title" data-impact>
  <div class="impact-band" data-impact-band>
    <span class="impact-blob" aria-hidden="true"></span>
    <div class="container impact-inner">
      <p class="impact-eyebrow mono">Impact in numbers</p>
      <h2 class="impact-title" id="impact-title" data-split>Results from real work.</h2>

      <ul role="list" class="impact-grid">
        <!-- 5+ Social platforms -->
        <li class="stat-card stat-card--wide" style="--i:0" data-stat-card>
          <span class="visually-hidden">5+ social platforms managed: LinkedIn, Instagram, Facebook, YouTube and Reddit. Technotreon.</span>
          <div class="card-inner" data-tilt-inner aria-hidden="true">
            <div class="stat-visual">
              <ul role="list" class="chips">
                <li class="chip" style="--i:0" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21H9z"/></svg></li>
                <li class="chip" style="--i:1" title="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"/></svg></li>
                <li class="chip" style="--i:2" title="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-2.2 0-3.5 1.4-3.5 3.6V11H8v3h2.5v7h3v-7H16l.5-3h-3v-1.3c0-.5.3-.7.8-.7z"/></svg></li>
                <li class="chip" style="--i:3" title="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.3-.4-4.8a2.5 2.5 0 0 0-1.8-1.8C19 5 12 5 12 5s-7 0-8.8.4A2.5 2.5 0 0 0 1.4 7.2C1 8.7 1 12 1 12s0 3.3.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5 19 12 19 12 19s7 0 8.8-.4a2.5 2.5 0 0 0 1.8-1.8C23 15.3 23 12 23 12zM10 15.5v-7l6 3.5z"/></svg></li>
                <li class="chip" style="--i:4" title="Reddit"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a2.3 2.3 0 0 0-3.9-1.6c-1.4-.9-3.2-1.5-5.2-1.6l1-4 3 .7a1.6 1.6 0 1 0 .3-1.4l-3.6-.8a.6.6 0 0 0-.7.4l-1.1 4.4c-2 .1-3.9.7-5.3 1.6A2.3 2.3 0 1 0 3 14.3a4 4 0 0 0 0 .8c0 2.9 3.6 5.3 8 5.3s8-2.4 8-5.3a4 4 0 0 0 0-.8A2.3 2.3 0 0 0 22 12zM8 13.8a1.3 1.3 0 1 1 2.6 0 1.3 1.3 0 0 1-2.6 0zm7.1 3.6c-1 .9-3.1.9-3.8.9s-2.8 0-3.8-.9a.4.4 0 0 1 .6-.6c.6.6 2 .8 3.2.8s2.6-.2 3.2-.8a.4.4 0 1 1 .6.6zm-.4-2.3a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6z"/></svg></li>
              </ul>
            </div>
            <div class="stat-meta">
              <span class="stat-num" data-count="5"><span data-digits>5</span><span class="stat-plus">+</span></span>
              <p class="stat-caption">Social platforms managed</p>
              <span class="stat-source"><span class="dot"></span>Technotreon</span>
            </div>
          </div>
        </li>

        <!-- 15+ SEO & UX improvements -->
        <li class="stat-card" style="--i:1" data-stat-card>
          <span class="visually-hidden">15+ SEO and UX improvements recommended from website audits. Technotreon.</span>
          <div class="card-inner" data-tilt-inner aria-hidden="true">
            <div class="stat-visual">
              <ul role="list" class="checks">
                <li class="check-row" style="--i:0">
                  <span class="check-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg></span>
                  <span class="check-label">Metadata &amp; titles</span>
                  <span class="check-bar"><span></span></span>
                </li>
                <li class="check-row" style="--i:1">
                  <span class="check-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg></span>
                  <span class="check-label">Heading hierarchy</span>
                  <span class="check-bar"><span></span></span>
                </li>
                <li class="check-row" style="--i:2">
                  <span class="check-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg></span>
                  <span class="check-label">Internal linking</span>
                  <span class="check-bar"><span></span></span>
                </li>
              </ul>
              <p class="checks-more">+12 more</p>
            </div>
            <div class="stat-meta">
              <span class="stat-num" data-count="15"><span data-digits>15</span><span class="stat-plus">+</span></span>
              <p class="stat-caption">SEO and UX improvements recommended from website audits</p>
              <span class="stat-source"><span class="dot"></span>Technotreon</span>
            </div>
          </div>
        </li>

        <!-- 100+ Respondents -->
        <li class="stat-card" style="--i:2" data-stat-card>
          <span class="visually-hidden">100+ respondents in primary research on influencer credibility. Your Growth Partner.</span>
          <div class="card-inner" data-tilt-inner aria-hidden="true">
            <div class="stat-visual">
              <div class="dots" data-dots>
                {dots.map((d) => <span class="dot" style={`--d:${d}`}></span>)}
              </div>
            </div>
            <div class="stat-meta">
              <span class="stat-num" data-count="100"><span data-digits>100</span><span class="stat-plus">+</span></span>
              <p class="stat-caption">Respondents in primary research on influencer credibility</p>
              <span class="stat-source"><span class="dot"></span>Your Growth Partner</span>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .impact {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    overflow: clip;
  }

  .impact-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #111;
    border-radius: 32px;
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }

  /* Content visible by default; hidden only once the boot has set js-ready. */
  html.js-ready .impact-band {
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  html.js-ready .impact-band.in-view {
    opacity: 1;
    transform: none;
  }

  html.motion-failsafe .impact-band {
    opacity: 1 !important;
    transform: none !important;
  }

  .impact-band.is-reduced {
    transition-duration: 150ms !important;
    transform: none !important;
  }

  .impact-blob {
    position: absolute;
    z-index: 0;
    top: -25%;
    left: 8%;
    width: min(60vw, 820px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(191, 63, 23, 0.65), transparent 62%);
    opacity: 0.12;
    filter: blur(44px);
    pointer-events: none;
    will-change: transform;
    animation: impact-drift 30s ease-in-out infinite alternate;
  }

  /* Pause the drift whenever the band is off screen. */
  .impact-band:not(.is-visible) .impact-blob {
    animation-play-state: paused;
  }

  .impact-band.is-reduced .impact-blob {
    display: none;
  }

  @keyframes impact-drift {
    from {
      transform: translate3d(-5%, -3%, 0);
    }
    to {
      transform: translate3d(9%, 7%, 0);
    }
  }

  .impact-inner {
    position: relative;
    z-index: 1;
  }

  .impact-eyebrow {
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .impact-title {
    margin-top: 0.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    color: #fff;
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
    letter-spacing: -0.025em;
  }

  .impact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  @media (min-width: 900px) {
    .impact-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }

  /* Card wrapper handles the rise-in; the inner element is the visible card + tilt. */
  .stat-card {
    --i: 0;
    list-style: none;
  }

  html.js-ready .stat-card {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
    transition-delay: calc(var(--i) * 120ms);
  }

  html.js-ready .impact-band.in-view .stat-card {
    opacity: 1;
    transform: none;
  }

  html.motion-failsafe .stat-card {
    opacity: 1 !important;
    transform: none !important;
  }

  .impact-band.is-reduced .stat-card {
    transition-duration: 150ms !important;
    transition-delay: 0s !important;
    transform: none !important;
  }

  .card-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 340px;
    height: 100%;
    padding: 32px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: #181818;
    overflow: hidden;
    transform: perspective(800px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition:
      transform 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  .card-inner.lit {
    border-color: rgba(191, 63, 23, 0.5);
  }

  /* Cursor spotlight + faint glare (desktop; toggled by the `lit` class). */
  .card-inner::before,
  .card-inner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }

  .card-inner::before {
    background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), rgba(255, 255, 255, 0.1), transparent 60%);
  }

  .card-inner::after {
    background: radial-gradient(130px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.14), transparent 55%);
    mix-blend-mode: screen;
  }

  .card-inner.lit::before,
  .card-inner.lit::after {
    opacity: 1;
  }

  .stat-visual,
  .stat-meta {
    position: relative;
    z-index: 1;
  }

  .stat-num {
    display: inline-flex;
    align-items: flex-start;
    color: #fff;
    font-weight: 600;
    font-size: clamp(72px, 9vw, 144px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .stat-plus {
    margin-left: 0.04em;
    color: var(--accent);
    font-size: 0.6em;
    line-height: 1;
  }

  .stat-caption {
    margin-top: 0.75rem;
    max-width: 24ch;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stat-source {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .stat-source .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Card 1 — platform chips */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chip {
    --i: 0;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    transition:
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }

  .chip svg {
    width: 22px;
    height: 22px;
    opacity: 0.6;
    transition: opacity 200ms var(--ease-out);
  }

  html.js-ready .chip {
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
    transition-delay: calc(var(--i) * 90ms + 200ms);
  }

  html.js-ready .impact-band.in-view .chip {
    opacity: 1;
    transform: none;
  }

  html.motion-failsafe .chip {
    opacity: 1 !important;
    transform: none !important;
  }

  .impact-band.is-reduced .chip {
    transition-duration: 150ms !important;
    transition-delay: 0s !important;
    transform: none !important;
  }

  @media (hover: hover) {
    .chip:hover {
      background: var(--accent);
      border-color: var(--accent);
    }

    .chip:hover svg {
      opacity: 1;
    }
  }

  /* Card 2 — checklist */
  .checks {
    display: grid;
    gap: 0.9rem;
    width: 100%;
  }

  .check-row {
    --i: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.5rem 0.7rem;
  }

  .check-ic {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
  }

  .check-ic svg {
    width: 12px;
    height: 12px;
  }

  .check-ic svg path {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
  }

  html.js-ready .impact-band.in-view .check-ic svg path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 400ms var(--ease-out);
    transition-delay: calc(var(--i) * 250ms + 300ms);
  }

  html.motion-failsafe .check-ic svg path,
  .impact-band.is-reduced .check-ic svg path {
    stroke-dashoffset: 0 !important;
    transition: none !important;
  }

  .check-label {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.75);
  }

  .check-bar {
    grid-column: 1 / -1;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .check-bar > span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  html.js-ready .check-bar > span {
    transition: transform 600ms var(--ease-out);
    transition-delay: calc(var(--i) * 250ms + 200ms);
  }

  html.js-ready .impact-band.in-view .check-bar > span {
    transform: scaleX(1);
  }

  html.motion-failsafe .check-bar > span,
  .impact-band.is-reduced .check-bar > span {
    transform: scaleX(1) !important;
    transition: none !important;
  }

  .checks-more {
    margin-top: 0.75rem;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Card 3 — dot grid */
  .dots {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 6px;
    width: min(100%, 220px);
  }

  .dot {
    --d: 0;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
  }

  html.js-ready .dots.dots-on .dot {
    background: var(--accent);
    transition: background-color 220ms var(--ease-out);
    transition-delay: calc(var(--d) * 1ms);
  }

  html.motion-failsafe .dot,
  .impact-band.is-reduced .dot {
    background: var(--accent) !important;
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .impact-blob {
      animation: none;
    }
  }

  @media (max-width: 899px) {
    .card-inner {
      min-height: 280px;
    }
  }
</style>
