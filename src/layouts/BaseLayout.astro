---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';
import { asset } from '../lib/paths';

interface Props {
  /** Page title without the site name. Leave empty on the home page. */
  title?: string;
  description?: string;
  /** Social preview image: a root-relative URL such as getImage().src. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image,
  imageAlt = `${site.name}, ${site.title}: selected work`,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? asset('/og/og-default.jpg'), Astro.site);
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#f5f5f2" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      // Motion boot: runs before paint, no imports, base-path independent.
      // - Enables the hidden initial states (js-ready) only now that a script is running.
      // - Effects are ON by default. Reduced motion only softens (handled in CSS via
      //   .reduce-motion); ?motion=on forces full motion.
      // - Safety: if the motion modules have not run within 1.5s, reveal everything.
      (function () {
        var el = document.documentElement;
        var forceMotion = /[?&]motion=on(&|$)/.test(location.search);
        var reduced = !forceMotion && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        el.classList.add('js-ready');
        if (reduced) el.classList.add('reduce-motion');
        if (forceMotion) el.classList.add('force-motion');
        window.setTimeout(function () {
          if (!el.classList.contains('motion-ran')) el.classList.add('motion-failsafe');
        }, 1500);
      })();
    </script>
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <button class="to-top" type="button" data-to-top aria-label="Back to top" hidden>
      <span class="to-top-arrow" aria-hidden="true">↑</span>
    </button>
    <script>
      import '../scripts/motion/index.js';
      import '../scripts/site';
    </script>
  </body>
</html>
